{
  "name": "aspireedge-lms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w @aspireedge/api\" \"npm run dev -w @aspireedge/web\"",
    "build": "npm run build -w @aspireedge/api && npm run build -w @aspireedge/web",
    "typecheck": "npm run typecheck -w @aspireedge/api && npm run typecheck -w @aspireedge/web",
    "test": "npm run test -w @aspireedge/api",
    "db:generate": "npm run db:generate -w @aspireedge/api",
    "db:migrate": "npm run db:migrate -w @aspireedge/api",
    "db:seed": "npm run db:seed -w @aspireedge/api",
    "db:sync": "npm run db:sync -w @aspireedge/api",
    "lint": "eslint apps",
    "admin:reset-password": "npm run admin:reset-password -w @aspireedge/api --",
    "mail:deliver": "npm run mail:deliver -w @aspireedge/api",
    "test:accounts": "npm run test:accounts -w @aspireedge/api",
    "worker:local": "npm run worker:local -w @aspireedge/api",
    "jobs:run": "npm run jobs:run -w @aspireedge/api"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.74.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
